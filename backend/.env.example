# 로컬 개발 기본값: SQLite 파일 DB (아무 설정 없이 바로 실행 가능)
# DATABASE_URL=sqlite:///./soh.db

# NCP Cloud DB for MySQL 등 실제 MySQL을 쓸 때 (docker-compose도 이 형식 사용)
# DATABASE_URL=mysql+pymysql://soh_user:soh_pass@localhost:3306/soh_db

# 학습된 model.pt + model_meta.json이 위치한 디렉터리
# MODEL_DIR=./app/ml/weights

# 프론트엔드 개발 서버 주소 (CORS 허용 origin, 콤마로 여러 개 지정 가능)
CORS_ORIGINS=http://localhost:5173
